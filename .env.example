# =========================================================================
# Priyanshi Bahore Portfolio SMTP Email Notification Configurations
# =========================================================================
# Set these variables to enable automatic email dispatches when someone
# submits details in your portfolio contact form.
#
# To use Gmail (recommended):
# 1. Go to your Google Account -> Security -> 2-Step Verification.
# 2. Turn it ON, then click "App passwords" at the very bottom.
# 3. Select app: "Other (custom name)", type "Portfolio Server", click Generate.
# 4. Copy the 16-character code and paste it below as SMTP_PASS.
# 5. Set SMTP_USER to your Gmail address and RECEIVER_EMAIL to your personal email.
# =========================================================================

# SMTP Server configurations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Sender Credentials (Change these to your details!)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# Notification Target Email (Where you want to receive the messages)
RECEIVER_EMAIL=priyanshipahore@gmail.com
